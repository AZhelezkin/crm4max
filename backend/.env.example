# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://crm4max:crm4max@localhost:5432/crm4max"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-min-32-chars"

# VK / Max
VK_APP_ID=12345678
VK_APP_SECRET="your-vk-app-secret"
VK_SERVICE_TOKEN="your-vk-service-token"

# Max Bot
# Два разных бота: мастер (личный кабинет) и клиент (запись/QR).
# MAX_BOT_TOKEN/MAX_BOT_NAME — legacy-fallback; для новых деплоев задавайте
# отдельные _MASTER и _CLIENT.
MAX_BOT_TOKEN_MASTER="your-master-bot-token"
MAX_BOT_NAME_MASTER="id9706002253_bot"
MAX_BOT_TOKEN_CLIENT="your-client-bot-token"
MAX_BOT_NAME_CLIENT="id9706002253_1_bot"
MAX_BOT_API_URL="https://botapi.max.ru"

# Cron
CRON_SECRET="your-cron-secret"

# ─── Chatwoot Gateway ─────────────────────────────────────────────────────────
# Публичный URL бэка — нужен для регистрации callback на старте.
PUBLIC_API_URL="http://localhost:3000"
CHATWOOT_GATEWAY_URL="https://gateway.stage.soldatov.dev"
CHATWOOT_GATEWAY_SECRET="max-gw-secret-2026-change-me"

# ─── S3 / Хранилище медиафайлов ──────────────────────────────────────────────
#
# ── Вариант 1: Yandex Object Storage (продакшн) ────────────────────────────
# Для Яндекс Облака используйте эту конфигурацию:
#
S3_REGION=ru-central1
S3_BUCKET=crm4max-media
S3_ACCESS_KEY=YCAJEgMRV2j_ULfHUvI00xbip
S3_SECRET_KEY=your-yandex-secret-key
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_URL=https://crm4max-media.storage.yandexcloud.net

# ── Вариант 2: MinIO (локальная разработка через docker-compose) ────────────
# Запустите: docker-compose up -d minio minio-init
# Бакет crm4max-media создаётся автоматически и становится публичным.
