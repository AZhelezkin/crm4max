# Продакшн переменные — скопируй в .env.prod и заполни

NODE_ENV=production
PORT=3000

# Yandex Managed PostgreSQL
# Хост смотреть в консоли YC → Managed PostgreSQL → Кластер → Хосты
DATABASE_URL=postgresql://crm4max:STRONG_PASSWORD@RC1B-XXXXXX.mdb.yandexcloud.net:6432/crm4max?sslmode=require

# Yandex Managed Redis
# Хост смотреть в консоли YC → Managed Redis → Кластер → Хосты
REDIS_URL=rediss://:STRONG_PASSWORD@RC1B-XXXXXX.mdb.yandexcloud.net:6380

JWT_SECRET=GENERATE_32_CHAR_RANDOM_STRING

VK_APP_ID=12345678
VK_APP_SECRET=your_vk_app_secret
VK_SERVICE_TOKEN=your_vk_service_token

MAX_BOT_TOKEN=your_max_bot_token
MAX_BOT_API_URL=https://botapi.max.ru

CRON_SECRET=GENERATE_RANDOM_STRING

# ─── Chatwoot Gateway ─────────────────────────────────────────────────────────
# Публичный API URL текущего бэка — нужен для регистрации callback на старте.
PUBLIC_API_URL=https://81-26-186-235.sslip.io

CHATWOOT_GATEWAY_URL=https://gateway.stage.soldatov.dev
CHATWOOT_GATEWAY_SECRET=max-gw-secret-2026-change-me

# ─── Yandex Object Storage (S3) ───────────────────────────────────────────────
# Сервисный аккаунт: crm4max-storage (роль storage.editor на папку)
# Бакет: crm4max-media (публичное чтение включено)
# Создать новый ключ: yc iam access-key create --service-account-name crm4max-storage
#
S3_REGION=ru-central1
S3_BUCKET=crm4max-media
S3_ACCESS_KEY=YOUR_KEY_ID
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_URL=https://storage.yandexcloud.net/crm4max-media
